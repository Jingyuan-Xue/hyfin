# Copy to .env and fill the API key when moving this package.
A2RAG_API_KEY=
A2RAG_CHAT_BASE_URL=https://llm.eulerai.au/v1
A2RAG_EMBEDDING_BASE_URL=https://llm.eulerai.au/v1
A2RAG_CHAT_MODEL=deepseek-v4-flash
A2RAG_EMBEDDING_MODEL=text-embedding-v4

# Server-side translation. Never expose these values in frontend JavaScript.
TRANSLATION_PROVIDER=tencent_tmt
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_TRANSLATION_HOST=tmt.tencentcloudapi.com
TENCENT_TRANSLATION_ACTION=TextTranslate
TENCENT_TRANSLATION_VERSION=2018-03-21
TENCENT_TRANSLATION_SERVICE=tmt
TENCENT_TRANSLATION_REGION=ap-beijing
TENCENT_TRANSLATION_PROJECT_ID=0
TRANSLATION_QPS=4.5
TRANSLATION_MAX_CHARS=1800
TRANSLATION_TIMEOUT_SECONDS=12

# Access gate for the public port. Leave DEMO_ACCESS_TOKEN empty for local-only
# use; set it to a random secret before exposing the demo to anyone else, since
# the keys above are metered and the API is otherwise unauthenticated.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
DEMO_ACCESS_TOKEN=
# Per-IP caps. "Expensive" covers online generation and translation (per hour);
# "general" covers every other /api/ route (per minute).
DEMO_RATE_LIMIT_EXPENSIVE=20
DEMO_RATE_LIMIT_GENERAL=240
# Set to 1 only behind a trusted reverse proxy / tunnel that sets X-Forwarded-For,
# otherwise every client collapses into one rate-limit bucket.
DEMO_TRUST_PROXY=0
