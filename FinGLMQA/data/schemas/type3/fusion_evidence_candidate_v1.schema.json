{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.type3.a2rag_tabgr.evidence_candidate.v1",
  "title": "Type 3 A2RAG + TabGR unified evidence candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "corpus_id",
    "document_id",
    "route",
    "display_text",
    "answer_safe_text",
    "source_markdown",
    "source_sha256",
    "line_range",
    "numeric_authorizations",
    "rank_signals",
    "fusion_score",
    "answer_eligible"
  ],
  "properties": {
    "schema_version": {"const": "finglmqa.type3.a2rag_tabgr.evidence_candidate.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "route": {"enum": ["text", "table"]},
    "display_text": {"type": "string", "minLength": 1},
    "answer_safe_text": {"type": "string"},
    "source_markdown": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "table_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "line_range": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}],
      "minItems": 2,
      "maxItems": 2
    },
    "cell_coordinates": {"type": "array"},
    "origin_cell_hashes": {"type": "array"},
    "numeric_authorizations": {"type": "array"},
    "rank_signals": {"type": "array", "minItems": 1},
    "fusion_score": {"type": "string", "pattern": "^[0-9]+$"},
    "answer_eligible": {"const": true}
  },
  "additionalProperties": true
}
