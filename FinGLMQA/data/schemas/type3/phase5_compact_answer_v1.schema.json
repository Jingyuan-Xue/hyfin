{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.type3.phase5.compact_answer.v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_version",
    "question_id",
    "question",
    "document_id",
    "answer_safe_text",
    "citations",
    "selected_candidate_ids",
    "semantic_trace"
  ],
  "properties": {
    "schema_version": {
      "const": "finglmqa.type3.phase5.compact_answer.v1"
    },
    "profile_version": {
      "const": "type3-a2rag-tabgr-compact-baseline-v1"
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "answer_safe_text": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "\\[未经授权数值\\]"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "selected_candidate_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "semantic_trace": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
