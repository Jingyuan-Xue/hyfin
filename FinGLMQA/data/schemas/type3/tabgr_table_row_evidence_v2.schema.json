{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.type3.tabgr.table_row_evidence.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "builder_version", "record_type", "evidence_id", "corpus_id",
    "document_id", "table_id", "table_index", "row_index", "heading_path",
    "active_header_rows", "flattened_column_headers", "row_path",
    "business_classification", "cells", "display_text", "answer_safe_text",
    "source_markdown", "table_line_range", "table_sha256", "numeric_authorizations",
    "unauthorized_numeric_values", "semantic_states", "base_search_text", "value_search_text",
    "own_row_header_text",
    "single_header_text", "multilevel_header_text", "hierarchical_row_text",
    "semantic_search_text", "legacy_flat_text", "search_text"
  ],
  "properties": {
    "schema_version": {"const": "finglmqa.type3.tabgr.table_row_evidence.v2"},
    "builder_version": {"const": "type3-tabgr-table-evidence-v2"},
    "record_type": {"const": "table_row"},
    "evidence_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "table_id": {"type": "string", "minLength": 1},
    "table_index": {"type": "integer", "minimum": 1},
    "row_index": {"type": "integer", "minimum": 0},
    "heading_path": {"type": "array", "items": {"type": "string"}},
    "active_header_rows": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "flattened_column_headers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "row_path": {"type": "array", "items": {"type": "string"}},
    "business_classification": {"type": "object"},
    "cells": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "display_text": {"type": "string", "minLength": 1},
    "answer_safe_text": {"type": "string", "minLength": 1},
    "source_markdown": {"type": "string", "minLength": 1},
    "table_line_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
    "table_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "numeric_authorizations": {"type": "array", "items": {"$ref": "tabgr_numeric_authorization_v1.schema.json"}},
    "unauthorized_numeric_values": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "semantic_states": {"type": "object"},
    "base_search_text": {"type": "string"},
    "value_search_text": {"type": "string"},
    "own_row_header_text": {"type": "string"},
    "single_header_text": {"type": "string"},
    "multilevel_header_text": {"type": "string"},
    "hierarchical_row_text": {"type": "string"},
    "semantic_search_text": {"type": "string"},
    "legacy_flat_text": {"type": "string"},
    "search_text": {"type": "string", "minLength": 1}
  }
}
