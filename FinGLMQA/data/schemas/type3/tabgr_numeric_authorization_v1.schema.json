{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.type3.tabgr.numeric_authorization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "corpus_id", "fact_id", "document_id", "table_id",
    "table_sha256", "source_markdown", "table_line_range", "cell_coordinate",
    "raw_value", "raw_value_sha256", "canonical_metric", "metric_year",
    "normalized_value", "normalized_unit", "selection_status", "source_candidate_id",
    "allowed_renderings", "authorization_id"
  ],
  "properties": {
    "schema_version": {"const": "finglmqa.type3.tabgr.numeric_authorization.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "fact_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "table_id": {"type": "string", "minLength": 1},
    "table_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_markdown": {"type": "string", "minLength": 1},
    "table_line_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
    "cell_coordinate": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
    "raw_value": {"type": "string", "minLength": 1},
    "raw_value_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_metric": {"type": "string", "minLength": 1},
    "metric_year": {"type": "integer", "minimum": 1900, "maximum": 2200},
    "normalized_value": {"type": "string", "minLength": 1},
    "normalized_unit": {"type": "string", "minLength": 1},
    "selection_status": {"enum": ["selected_single_value", "resolved_by_confidence"]},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "allowed_renderings": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authorization_id": {"type": "string", "pattern": "^t3tabgr-auth-[0-9a-f]{24}$"}
  }
}
