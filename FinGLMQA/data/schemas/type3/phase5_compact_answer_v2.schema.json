{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.type3.phase5.compact_answer.v2",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false
    },
    "legacyCitation": {
      "type": "object",
      "required": [
        "citation_kind",
        "corpus_id",
        "document_id",
        "citation_id",
        "candidate_id",
        "source_kind",
        "source_markdown",
        "line_range",
        "content_sha256",
        "heading_path"
      ],
      "properties": {
        "citation_kind": {"const": "legacy_evidence"},
        "corpus_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "citation_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "source_kind": {"type": "string", "minLength": 1},
        "source_markdown": {"type": "string", "minLength": 1},
        "line_range": {"$ref": "#/$defs/range"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "heading_path": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "phase5Citation": {
      "type": "object",
      "required": [
        "citation_kind",
        "corpus_id",
        "document_id",
        "candidate_id",
        "route",
        "source_markdown",
        "line_range",
        "char_range",
        "byte_range",
        "source_sha256",
        "content_sha256",
        "authorization_ids"
      ],
      "properties": {
        "citation_kind": {"const": "phase5_a2rag_text"},
        "corpus_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "route": {"const": "text"},
        "source_markdown": {"type": "string", "minLength": 1},
        "line_range": {"$ref": "#/$defs/range"},
        "char_range": {
          "oneOf": [
            {"$ref": "#/$defs/range"},
            {"type": "null"}
          ]
        },
        "byte_range": {
          "oneOf": [
            {"$ref": "#/$defs/range"},
            {"type": "null"}
          ]
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "profile_version",
    "question_id",
    "question",
    "document_id",
    "answer_safe_text",
    "citations",
    "selected_candidate_ids",
    "semantic_trace"
  ],
  "properties": {
    "schema_version": {
      "const": "finglmqa.type3.phase5.compact_answer.v2"
    },
    "profile_version": {
      "const": "type3-a2rag-tabgr-compact-baseline-v2"
    },
    "question_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "answer_safe_text": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "\\[未经授权数值\\]"}
    },
    "citations": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/phase5Citation"},
          {"$ref": "#/$defs/legacyCitation"}
        ]
      }
    },
    "selected_candidate_ids": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "semantic_trace": {
      "type": "object",
      "required": [
        "schema_version",
        "profile_version",
        "semantic_input",
        "source_phase4_packet_sha256",
        "composer",
        "selected_candidate_ids",
        "semantic_trace_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "finglmqa.type3.phase5.compact_run_trace.v2"
        },
        "profile_version": {
          "const": "type3-a2rag-tabgr-compact-baseline-v2"
        },
        "semantic_input": {
          "type": "object",
          "required": ["corpus_id", "document_id", "question"],
          "properties": {
            "corpus_id": {"type": "string", "minLength": 1},
            "document_id": {"type": "string", "minLength": 1},
            "question": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "source_phase4_packet_sha256": {"$ref": "#/$defs/sha256"},
        "composer": {
          "type": "object",
          "required": [
            "schema_version",
            "profile_version",
            "composer_version",
            "semantic_input",
            "mode",
            "minimum_question_recall",
            "ranked_sentence_count",
            "top_ranked_sentences",
            "selected_candidate_ids",
            "selected_numeric_authorizations",
            "legacy_answer_sha256",
            "semantic_trace_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "finglmqa.type3.phase5.compact_trace.v2"
            },
            "profile_version": {
              "const": "type3-a2rag-tabgr-compact-baseline-v2"
            },
            "composer_version": {
              "const": "type3-phase5-compact-composer-v2"
            },
            "semantic_input": {
              "type": "object",
              "required": ["question"],
              "properties": {
                "question": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "mode": {
              "enum": [
                "legacy_only",
                "legacy_plus_a2rag",
                "retrieval_only",
                "retrieval_only_fallback"
              ]
            },
            "minimum_question_recall": {"const": "0.08"},
            "ranked_sentence_count": {"type": "integer", "minimum": 0},
            "top_ranked_sentences": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": [
                  "candidate_id",
                  "evidence_position",
                  "text",
                  "ranking_value",
                  "question_recall",
                  "sentence_precision",
                  "rank_signal",
                  "heading_path"
                ],
                "properties": {
                  "candidate_id": {"type": "string", "minLength": 1},
                  "evidence_position": {"type": "integer", "minimum": 0},
                  "text": {"type": "string", "minLength": 1},
                  "ranking_value": {"type": "string"},
                  "question_recall": {"type": "string"},
                  "sentence_precision": {"type": "string"},
                  "rank_signal": {"type": "string"},
                  "heading_path": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                },
                "additionalProperties": false
              }
            },
            "selected_candidate_ids": {
              "type": "array",
              "maxItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "selected_numeric_authorizations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "schema_version",
                  "authorization_id",
                  "authorization_rule",
                  "corpus_id",
                  "document_id",
                  "atom_id",
                  "literal",
                  "literal_sha256",
                  "allowed_renderings",
                  "source_markdown",
                  "source_sha256",
                  "content_sha256"
                ],
                "properties": {
                  "schema_version": {"type": "string", "minLength": 1},
                  "authorization_id": {"type": "string", "minLength": 1},
                  "authorization_rule": {"type": "string", "minLength": 1},
                  "corpus_id": {"type": "string", "minLength": 1},
                  "document_id": {"type": "string", "minLength": 1},
                  "atom_id": {"type": "string", "minLength": 1},
                  "literal": {"type": "string", "minLength": 1},
                  "literal_sha256": {"$ref": "#/$defs/sha256"},
                  "allowed_renderings": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "source_markdown": {"type": "string", "minLength": 1},
                  "source_sha256": {"$ref": "#/$defs/sha256"},
                  "content_sha256": {"$ref": "#/$defs/sha256"}
                },
                "additionalProperties": false
              }
            },
            "legacy_answer_sha256": {"$ref": "#/$defs/sha256"},
            "semantic_trace_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "selected_candidate_ids": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "semantic_trace_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
