{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.phase8.selected_fact_filters.v1",
  "title": "SelectedFactFilters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_ids", "stock_codes", "report_years", "metric_years", "canonical_metrics", "normalized_units"],
  "properties": {
    "schema_version": {"const": "finglmqa.phase8.selected_fact_filters.v1"},
