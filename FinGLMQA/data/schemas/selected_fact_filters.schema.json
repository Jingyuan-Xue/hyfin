    "stock_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "report_years": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
    "metric_years": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
    "canonical_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "normalized_units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
