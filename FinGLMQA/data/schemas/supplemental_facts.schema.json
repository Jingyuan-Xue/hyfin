{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.phase9.supplemental_fact.v1",
  "title": "Phase 9 Supplemental Fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["supplemental_fact_id", "schema_version", "document_id", "stock_code", "report_year", "metric_year", "canonical_metric", "normalized_unit", "company", "statement", "normalized_value", "fact_source", "validation_versions", "tabgr_trace_fingerprint", "source_table_id", "source_table_index", "source_row_index", "source_col_index", "source_line_start", "source_line_end", "source_markdown", "provenance_json", "created_from_requirement_ids"],
  "properties": {
    "supplemental_fact_id": {"type": "string", "pattern": "^sf_[0-9a-f]{24}$"},
    "schema_version": {"const": "finglmqa.phase9.supplemental_fact.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "stock_code": {"type": "string", "minLength": 1},
    "report_year": {"type": "integer"},
    "metric_year": {"type": "integer"},
    "canonical_metric": {"type": "string", "minLength": 1},
    "normalized_unit": {"type": "string", "minLength": 1},
    "company": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "normalized_value": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "fact_source": {"const": "supplemental_tabgr"},
    "validation_versions": {"type": "object", "minProperties": 1},
    "tabgr_trace_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_table_id": {"type": "string", "minLength": 1},
    "source_table_index": {"type": "integer"},
    "source_row_index": {"type": "integer"},
    "source_col_index": {"type": "integer"},
    "source_line_start": {"type": ["integer", "null"]},
    "source_line_end": {"type": ["integer", "null"]},
    "source_markdown": {"type": "string", "minLength": 1},
    "provenance_json": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "created_from_requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
