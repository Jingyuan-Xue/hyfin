{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.phase8.fact_lookup_result.v1",
  "title": "FactLookupResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirement_id", "status", "records", "repository_fingerprint"],
  "properties": {
    "schema_version": {"const": "finglmqa.phase8.fact_lookup_result.v1"},
    "requirement_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["found", "not_found", "ambiguous"]},
    "records": {"type": "array", "items": {"$ref": "#/$defs/factRecord"}},
    "repository_fingerprint": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "factRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "document_id", "stock_code", "company", "report_year", "metric_year", "canonical_metric", "normalized_value", "normalized_unit", "source_table_id", "source_line_start", "source_line_end", "provenance_json"],
      "properties": {
        "fact_id": {"type": "string"},
        "document_id": {"type": "string"},
        "stock_code": {"type": "string"},
        "company": {"type": "string"},
        "report_year": {"type": "integer"},
        "metric_year": {"type": "integer"},
        "canonical_metric": {"type": "string"},
        "normalized_value": {"type": "string"},
        "normalized_unit": {"type": "string"},
        "source_table_id": {"type": "string"},
        "source_line_start": {"type": ["integer", "null"]},
        "source_line_end": {"type": ["integer", "null"]},
        "provenance_json": {"type": "string"}
      }
    }
  }
}
