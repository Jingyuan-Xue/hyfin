{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finglmqa.phase8.question_analysis.v1",
  "title": "QuestionAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_version", "request_id", "question_sha256", "normalized_question", "company_mentions", "year_mentions", "metric_mentions", "formula_mentions", "concerns", "cardinalities", "intents", "narrative_mode", "evidence_kinds", "output_entity_axis", "output_period_axis", "dynamic_target_dependency", "unsupported_markers", "ambiguity_findings"],
  "properties": {
    "schema_version": {"const": "finglmqa.phase8.question_analysis.v1"},
    "analysis_version": {"type": "string"},
    "request_id": {"type": "string"},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalized_question": {"type": "string", "minLength": 1},
    "company_mentions": {"type": "array", "items": {"$ref": "#/$defs/companyMention"}},
    "year_mentions": {"type": "array", "items": {"$ref": "#/$defs/yearMention"}},
    "metric_mentions": {"type": "array", "items": {"$ref": "#/$defs/metricMention"}},
    "formula_mentions": {"type": "array", "items": {"type": "object"}},
    "concerns": {"type": "array", "items": {"$ref": "#/$defs/concern"}},
    "cardinalities": {"type": "object", "additionalProperties": false, "required": ["companies", "years", "metrics", "concerns"], "properties": {"companies": {"type": "integer", "minimum": 0}, "years": {"type": "integer", "minimum": 0}, "metrics": {"type": "integer", "minimum": 0}, "concerns": {"type": "integer", "minimum": 0}}},
    "intents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["lookup", "compare", "rank", "aggregate", "calculate", "narrative"]}},
    "narrative_mode": {"type": ["string", "null"], "enum": ["explain", "summarize", null]},
    "evidence_kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["structured_fact", "table", "narrative"]}},
    "output_entity_axis": {"type": "array"},
    "output_period_axis": {"type": "array", "items": {"type": "integer"}},
    "dynamic_target_dependency": {"type": "boolean"},
    "unsupported_markers": {"type": "array"},
    "ambiguity_findings": {"type": "array"}
  },
  "$defs": {
    "span": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2},
    "companyMention": {"type": "object", "additionalProperties": false, "required": ["raw_text", "span", "mention_ordinal", "hint_source"], "properties": {"raw_text": {"type": "string"}, "span": {"$ref": "#/$defs/span"}, "mention_ordinal": {"type": "integer", "minimum": 0}, "hint_source": {"enum": ["question", "request_hint"]}}},
    "yearMention": {"type": "object", "additionalProperties": false, "required": ["raw_text", "span", "mention_ordinal", "years", "role", "is_output_axis"], "properties": {"raw_text": {"type": "string"}, "span": {"$ref": "#/$defs/span"}, "mention_ordinal": {"type": "integer", "minimum": 0}, "years": {"type": "array", "items": {"type": "integer", "minimum": 1900, "maximum": 2200}}, "role": {"enum": ["report_year", "metric_year", "formula_operand", "output_period", "corpus_year", "unresolved"]}, "is_output_axis": {"type": "boolean"}}},
    "metricMention": {"type": "object", "additionalProperties": false, "required": ["raw_text", "span", "mention_ordinal", "candidates", "status"], "properties": {"raw_text": {"type": "string"}, "span": {"$ref": "#/$defs/span"}, "mention_ordinal": {"type": "integer", "minimum": 0}, "candidates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "status": {"enum": ["unique", "missing", "ambiguous"]}}},
    "concern": {"type": "object", "additionalProperties": false, "required": ["concern_id", "mention_ordinal", "kind", "raw_text", "canonical_metric", "formula_id", "metadata_field"], "properties": {"concern_id": {"type": "string"}, "mention_ordinal": {"type": "integer", "minimum": 0}, "kind": {"enum": ["metric", "formula", "metadata", "narrative"]}, "raw_text": {"type": "string"}, "canonical_metric": {"type": ["string", "null"]}, "formula_id": {"type": ["string", "null"]}, "metadata_field": {"type": ["string", "null"]}, "normalized_unit": {"type": ["string", "null"]}, "unit_source": {"enum": ["question", "request_hint", "catalog", "formula", "none", "ambiguous"]}}}
  }
}
